# Google Gemini API key (required for AI test planning)
GEMINI_API_KEY=your_key_here

# Optional: Override default Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional integrations
SLACK_WEBHOOK_URL=        # Report notifications (optional)
TELEGRAM_BOT_TOKEN=       # Report notifications (optional)
DEBUG=                    # Set to 1 to enable debug logging
